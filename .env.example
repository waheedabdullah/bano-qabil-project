# Al Shifa Clinic — copy to .env and fill values
# Restart npm run dev after changing .env
#
# Vercel deploy:
# Project → Settings → Environment Variables → add all VITE_FIREBASE_* keys
# Then Redeploy (Vite reads these at BUILD time)

# Doctor OTP emails (Gmail SMTP) — local OTP only
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Firebase (Vite requires VITE_ prefix)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
